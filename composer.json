{
    "name": "nelsius/nelsius-pay-php",
    "description": "The official PHP & Laravel SDK for Nelsius Pay API V2",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nelsius",
        "nelsiuspay",
        "payments",
        "checkout",
        "laravel",
        "mobile-money",
        "orange-money",
        "mtn-momo",
        "cameroon",
        "africa",
        "fintech"
    ],
    "homepage": "https://nelsiuspay.com",
    "authors": [
        {
            "name": "Nelson Siebi",
            "email": "nelsonsiebi237@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.5",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "suggest": {
        "illuminate/support": "Requis pour l'intégration Laravel automatique (^9.0|^10.0|^11.0)"
    },
    "autoload": {
        "psr-4": {
            "Nelsius\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nelsius\\Laravel\\NelsiusServiceProvider"
            ],
            "aliases": {
                "Nelsius": "Nelsius\\Laravel\\Facades\\Nelsius"
            }
        }
    }
}
